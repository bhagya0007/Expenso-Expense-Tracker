# Application Environment
APP_NAME=Expenso Statement Parser API
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Security & CORS
SECRET_KEY=change-this-in-production-secret-key-32chars
CORS_ORIGINS=["http://localhost:8080","http://localhost:8081","http://localhost:8082","http://localhost:8083","http://localhost:3000"]

# File Upload Limits
MAX_UPLOAD_SIZE_MB=20
TEMP_STORAGE_DIR=/tmp/expenso_parser

# OCR Config
OCR_ENGINE_ENABLED=True
TESSERACT_CMD=tesseract
